# Firebase web app configuration (public identifiers, not Admin credentials).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side Firebase configuration.
FIREBASE_PROJECT_ID=
# Production recommendation in the shared accelbusiness-hub project:
# create a named Firestore database and set this to its database ID.
FIRESTORE_DATABASE_ID=
WORKSPACE_ID=management-v2
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ORG_NAME=My organization

# Public URL used in notification links.
APP_BASE_URL=

# Email notifications (Resend REST API).
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# SMS notifications (Twilio Messaging REST API).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Local/emulator use only. Never set these on a public production deployment.
# NEXT_PUBLIC_USE_EMULATORS=true
# MANAGEMENT_EMULATOR=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# NOTIFICATIONS_DISABLED=true
