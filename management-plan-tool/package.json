{
  "name": "management-plan-feedback",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/domain.test.ts",
    "test:rules": "firebase emulators:exec --project demo-management --only auth,firestore \"vitest run tests/security.test.ts\"",
    "test:e2e": "firebase emulators:exec --project demo-management --only auth,firestore \"playwright test\"",
    "emulators": "firebase emulators:start --project demo-management --only auth,firestore",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:rules && npm run build"
  },
  "dependencies": {
    "firebase": "12.18.0",
    "firebase-admin": "^13.0.0",
    "next": "16.3.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "15.29.0",
    "typescript": "^5.9.2",
    "vitest": "5.0.0"
  }
}
