# Public Firebase WEB application configuration (not Admin credentials).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Use application default credentials on Google hosting, OR a
# secret containing the JSON service account. NEVER prefix it NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
WORKSPACE_ID=management
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ORG_NAME=My organization

# Local/emulator use only. Never set either emulator flag on a public deployment.
# MANAGEMENT_EMULATOR=true
# NEXT_PUBLIC_USE_EMULATORS=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
